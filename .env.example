# Plantilla de entorno. Copia a `.env` y rellena.
#
# `.env*` está en `.gitignore` y no se versiona. Los valores de abajo son
# marcadores de posición: ninguno es un valor real.
#
# Ninguna de estas variables llega al bundle del cliente sin querer. Las que
# llevan el prefijo `NEXT_PUBLIC_` **sí** se sustituyen por un literal al compilar
# y salen en el JavaScript del navegador, así que el nombre es una advertencia:
# lo que pongas ahí es público para siempre. `NEXT_PUBLIC_SITE_URL` es la única
# que hace falta en cliente, y por eso es pública; el resto no lo lleva.

# ---------------------------------------------------------------------------
# Obligatorias
# ---------------------------------------------------------------------------

# Clave de `x-api-key` con la que el middleware protege `/api/actividades/*` y
# `/api/v1/events`. Sin ella el middleware responde 503 a **toda** la API
# protegida, por diseño: un despliegue sin configurar no está degradado, está roto.
#
# Es la MISMA clave que consume la app móvil, en su `GASTEIZCLICK_API_KEY`. No es
# un secreto de servidor: viaja al cliente y sale del APK con un `strings`. Para
# que no llegue al bundle, la autorización tiene que estar en el backend, no aquí.
API_KEY=

# URL base del sitio. Se usa para los enlaces de confirmación y de baja del
# newsletter, para las URLs de las notificaciones push y para el contacto de
# VAPID.
#
# Sin ella, en producción, `lib/email.ts` **lanza**: los enlaces se construirían
# contra `localhost:3000` y la doble confirmación no se podría completar, sin que
# nada lo delatara hasta que un suscriptor escribiera. No la pongas apuntando a
# `localhost` en producción por costumbre.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Push
# ---------------------------------------------------------------------------
# Se generan con `npx web-push generate-vapid-keys`. El par tiene que coincidir:
# la pública va al cliente y la privada nunca sale del servidor.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Poner a `1` arranca el planificador de push dentro del proceso de Next.
# `/api/push/send` existe para poder dispararlo **desde fuera**, para el caso de
# que el proceso se haya caído.
ENABLE_PUSH_SCHEDULER=0

# Hora local del digest, en `Europe/Madrid`. Está también en `nixpacks.toml`
# porque un contenedor Node sin `TZ` va en UTC y dispararía dos horas tarde en
# horario de verano.
PUSH_DIGEST_HOUR=9

# ---------------------------------------------------------------------------
# Correo
# ---------------------------------------------------------------------------
# Gmail SMTP con contraseña de aplicación, no con la contraseña de la cuenta.
# Sin las dos, en producción `sendMail` devuelve error y no simula el envío: un
# mock devolvería `ok: true` y el newsletter parecería enviado sin llegar a nadie.
EMAIL_USER=
EMAIL_PASS=

# ---------------------------------------------------------------------------
# Fuentes
# ---------------------------------------------------------------------------
# La Genterula lo publica en el bundle de Kiosko Cultura. **No es un secreto**, y
# sacarlo del código no lo revoca: hay que pedir que lo revoquen.
MEC_TOKEN=

# ---------------------------------------------------------------------------
# Opcionales
# ---------------------------------------------------------------------------

# Token de ingestión de Axiom. Sin él, los errores se quedan en la consola.
AXIOM_TOKEN=
AXIOM_DATASET=gasteiz-agenda

# Dónde viven los datos que se escriben. Sin esto usan las rutas relativas al
# directorio de trabajo, que en Dokploy **se pierden en cada redeploy** salvo que
# haya un volumen montado.
# SUBSCRIBERS_PATH=/datos/suscriptores.json
# PUSH_DB_DIR=/datos