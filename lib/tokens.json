{
  "$schema": "https://design-tokens.github.io/community-group/format",
  "description": "Canonical design tokens for Gasteiz Click web (Tailwind v4) + React Native (appTheme.tsx). Single source of truth: change here, both read via their own adapters.",
  "meta": {
    "generated": "2026-10-14",
    "web_adapter": "app/globals.css (CSS vars / @theme)",
    "native_adapter": "theme/appTheme.tsx (theme/*)",
    "remove_after": "both adapters consume this file directly"
  },
  "color": {
    "bg": "#0B0E14",
    "bgMuted": "#141821",
    "bgElevated": "#1B2130",
    "surface": "#1B2130",
    "surfaceHover": "#222A3B",
    "fg": "#F6F5F3",
    "fgMuted": "#A6B0BD",
    "fgSubtle": "#7C8794",
    "border": "#2A3345",
    "borderHover": "#3B4458",
    "accent": "#BC0202",
    "accentHover": "#D40A0A",
    "accentSubtle": "#FFD9D4",
    "accentSoft": "#FFF0EC",
    "brandRed": "#BC0202",
    "brandBone": "#F6F5F3",
    "brandInk": "#0B0E14",
    "green": "#4CAF50",
    "blue": "#2563EB",
    "teal": "#0D9488",
    "hot": "#EC4899",
    "violet": "#7C3AED",
    "lime": "#84CC16",
    "amber": "#F59E0B",
    "amberSubtle": "#FEF3C7",
    "amberSoft": "#FFFBEB"
  },
  "typography": {
    "display": "Archivo",
    "body": "Archivo",
    "mono": "JetBrainsMono-Regular",
    "scaleDisplay": "2.875rem/32px",
    "scaleH1": "1.5rem/24px",
    "scaleH2": "1.25rem/20px",
    "scaleH3": "1.0625rem/17px",
    "scaleBody": "0.9375rem/15px",
    "scaleSmall": "0.8125rem/13px"
  },
  "radius": {
    "sm": "0.375rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "xl": "1rem",
    "2xl": "1.5rem",
    "round": "9999px"
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 20,
    "xl": 24,
    "2xl": 32,
    "3xl": 48
  },
  "theme": {
    "default": "dark",
    "modes": ["dark", "light"],
    "accentSeasons": {
      "brand-red": "#BC0202",
      "cosmos": "#6366F1",
      "amber": "#F59E0B"
    }
  },
  "accessibility": {
    "focusRing": "2px solid accent, 2px offset, 6px radius",
    "minTouchTarget": "44px",
    "contrastMinimum": "4.5:1 text, 3:1 UI"
  }
}